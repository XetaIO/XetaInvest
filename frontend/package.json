{
    "name": "frontend",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "packageManager": "pnpm@10.12.4",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && tsc --noEmit --composite false -p tsconfig.node.json && vite build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit && tsc --noEmit --composite false -p tsconfig.node.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "oxlint .",
        "lint:fix": "oxlint --fix .",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/react-query": "^5",
        "i18next": "^26.4.2",
        "i18next-browser-languagedetector": "^8.2.1",
        "lightweight-charts": "^5.2.0",
        "lucide-react": "^1.45.0",
        "react": "^19",
        "react-dom": "^19",
        "react-helmet-async": "^3.0.0",
        "react-i18next": "^17.0.13",
        "react-router": "^8.3.0",
        "react-toastify": "^11.1.0",
        "recharts": "^3.10.1"
    },
    "devDependencies": {
        "@testing-library/dom": "^10.4.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@vitejs/plugin-react": "^6.0.5",
        "clsx": "^2.1.1",
        "jsdom": "^29.1.1",
        "oxlint": "^1.85.0",
        "oxlint-tsgolint": "^7.0.2002",
        "prettier": "^3.9.9",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "typescript": "^7.0.0",
        "vite": "^8.2.1",
        "vitest": "^4.1.11"
    },
    "pnpm": {
        "overrides": {
            "nanoid": "^3.3.18",
            "postcss": "^8.5.26"
        }
    }
}
